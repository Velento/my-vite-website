# ── Stage 1: зависимости ──────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

# Копируем только package файлы — кешируем слой
COPY package*.json ./
RUN npm ci --frozen-lockfile

# ── Stage 2: тесты (для AI-агента) ───────────────────────────────────────────
FROM deps AS test
WORKDIR /app
COPY . .

# Пользователь без root — дополнительная защита
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

CMD ["npm", "run", "test"]

# ── Stage 3: production build ─────────────────────────────────────────────────
FROM deps AS builder
WORKDIR /app
COPY . .

# Передаём секреты через build args (не попадают в финальный образ)
ARG VITE_TELEGRAM_BOT_TOKEN
ARG VITE_TELEGRAM_CHAT_ID

ENV VITE_TELEGRAM_BOT_TOKEN=$VITE_TELEGRAM_BOT_TOKEN
ENV VITE_TELEGRAM_CHAT_ID=$VITE_TELEGRAM_CHAT_ID

RUN npm run build

# ── Stage 4: production (только статика + nginx) ──────────────────────────────
FROM nginx:alpine AS production
LABEL maintainer="legal_line"

# Копируем только собранную статику
COPY --from=builder /app/dist /usr/share/nginx/html
COPY agent/sandbox/nginx.conf /etc/nginx/conf.d/default.conf

# nginx работает от non-root
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chmod -R 755 /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O- http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]

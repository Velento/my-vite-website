# Aggressive cache for fingerprinted build artifacts (Vite hashes filenames so
# any code change → new filename → new download). Used by Cloudflare Pages.
# GitHub Pages ignores this file harmlessly.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Partytown library files — same content for the lifetime of the package
# version, safe to cache for a long time.
/~partytown/*
  Cache-Control: public, max-age=31536000, immutable

# Static images and icons in the project root (favicons, og-image)
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

# HTML — short cache so we can ship updates fast
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate

# Telegram Bot — get token from @BotFather (/newbot), then chat ID via getUpdates.
# Required for the lead form to deliver submissions. DO NOT commit real tokens.
# Set real values in GitHub Secrets or Cloudflare Worker secrets; for local
# development use a private `.env.local` that is gitignored.
VITE_TELEGRAM_BOT_TOKEN=<your_bot_token_here>
VITE_TELEGRAM_CHAT_ID=<your_chat_id_here>

# Google Ads conversion tracking. Format MUST be `AW-XXXXXXXXX/LABEL` (account
# ID + slash + conversion label from Ads UI). Without the label, gtag fires the
# event but Ads silently drops it. See docs/google-ads-setup.md.
#
# Form submit conversion (a completed lead form):
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX/CONVERSION_LABEL
#
# Contact-click conversion (tel: / WhatsApp / Telegram / Viber click). Create a
# separate conversion action in Google Ads and paste its AW-XXXX/LABEL here.
# This lets "Maximize conversions" bidding optimise for calls + messages, which
# are the bulk of legal-service leads - so the campaign brings MORE leads, not
# only form fills. Leave unset to keep contact clicks out of Ads conversions.
VITE_GOOGLE_ADS_CONTACT_CONVERSION_ID=AW-XXXXXXXXX/CONTACT_LABEL

# hCaptcha SITE key (public, safe to expose) - from dashboard.hcaptcha.com.
# When set, the lead form shows an hCaptcha challenge. Pair it with the
# HCAPTCHA_SECRET set on the Cloudflare Worker (`wrangler secret put`).
# Leave unset to disable the captcha entirely (form still works).
VITE_HCAPTCHA_SITE_KEY=<your_hcaptcha_site_key>
